# 数据库
DATABASE_URL="file:./dev.db"

# 服务器配置
PORT=3001
CLIENT_URL=http://localhost:5173

# ===== AI 服务（OpenAI 兼容协议）=====
# 选择使用哪个 AI 服务，可选值：openrouter | ark
# 不配置时默认为 openrouter，既有部署无需改动。
# 两个 provider 的模型名不同，切换 provider 时会自动使用各自的默认模型。
AI_PROVIDER=openrouter

# 通用 API Key 覆盖（可选）。配置后优先级最高，可配合任意 provider 使用。
# AI_API_KEY=

# OpenRouter（AI_PROVIDER=openrouter 时使用）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 火山方舟 Ark（AI_PROVIDER=ark 时使用）
ARK_API_KEY=your_ark_api_key_here
# 方舟的模型名或推理接入点 ID，例如 doubao-seed-1-6-250615 或 ep-2025xxxx-xxxxx
ARK_MODEL=doubao-seed-1-6

# 高级选项（一般无需配置）
# 覆盖默认模型（对所有 provider 生效）
# AI_MODEL=
# 覆盖默认接口地址，可指向自建网关或其他 OpenAI 兼容服务
# AI_BASE_URL=

# ===== Jev 决策预筛（TypeSafe System One 模型，可选）=====
# 通过 QuickRouter 中转访问 jev-1.13.0。默认关闭；开启后：
#   analyzeContent 先由 Jev 做 typed decision（isReal/relevance/keywordMentioned/importance），
#   值得保留的条目才调用 LLM 生成文本摘要 —— 显著降低 LLM 调用量与成本。
# JEV_ENABLED=true
# JEV_API_KEY=quickrouter_or_openrouter_key_here
# JEV_BASE_URL=https://api.quickrouter.ai
# JEV_MODEL=jev-1.13.0

# Twitter API (twitterapi.io)
TWITTER_API_KEY=your_twitter_api_key_here

# 邮件通知 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=notify_to@example.com
